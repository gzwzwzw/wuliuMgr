-size: 20px;\">{{ item.title }}</span>\n        </span>\n        <a-menu-item v-for=\"menu in item.children\" :key=\"menu.title\">\n          <router-link :to=\"menu.path\"  style=\"font-size: 18px;\">\n            <i :class=\"'iconfont icon-r-' + menu.icon\" style=\"font-size: 22px;margin-right: 4px;\"></i>\n            {{ menu.title }}\n          </router-link>\n        </a-menu-item>\n      </a-sub-menu>\n    </a-menu>\n  </a-layout-sider>\n</template>\n\n<script>\n\nexport default {\n\n  data() {\n    return {\n      menus: [\n        {\n          title: '基础管理',\n          icon: 'home',\n          children: [\n            {title: '商品管理', path: '/commodity', icon: 'shield'},\n            {title: '来往单位', path: '/company', icon: 'refresh'},\n            {title: '员工管理', path: '/employee', icon: 'user2'},\n            {title: '仓库管理', path: '/warehouse', icon: 'building'},\n          ]\n        },\n        {\n          title: '销售管理',\n          icon: 'paper',\n          children: [\n            {title: '销售开票', path: '/sale/create', icon: 'yes'},\n            {title: '销售记录', path: '/sale/record', icon: 'edit'},\n          ]\n        },\n        {\n          title: '配送管理',\n          icon: 'right',\n          children: [\n            {title: '申请配送', path: '/delivery/create', icon: 'yes'},\n            {title: '配送列表', path: '/delivery/list', icon: 'list'},\n          ]\n        },\n        {\n          title: '运输管理',\n          icon: 'refresh',\n          children: [\n            {title: '车辆资料', path: '/vehicle', icon: 'shield'},\n            {title: '驾驶员资料', path: '/driver', icon: 'user3'},\n          ]\n        },\n        {\n          title: '图表分析',\n          icon: 'list',\n          children: [\n            {title: '入库分析', path: '/analyze/in', icon: 'left'},\n            {title: '出库分析', path: '/analyze/out', icon: 'right'},\n          ]\n        },\n        {\n          title: '系统管理',\n          icon: 'setting',\n          children: [\n            {title: '安全设置', path: '/security', icon: 'shield'},\n            {title: '操作员管理', path: '/admin', icon: 'user1'},\n            {title: '权限列表', path: '/role', icon: 'add'}\n          ]\n        },\n        {\n          title: '日志管理',\n          icon: 'team',\n          children: [\n            {title: '登录日志', path: '/loginlog', icon: 'yes'},\n            {title: '操作日志', path: '/systemlog', icon: 'edit'}\n          ]\n        }\n      ]\n    }\n  },\n\n}\n\n</script>\n\n<style scoped>\n\n#components-layout-demo-fixed-sider .logo {\n  padding: 10px 15px;\n  height: 50px;\n  font-size: 20px;\n  margin: 16px;\n  color: black;\n  letter-spacing: 2px;\n}\n\n.ant-menu {\n  letter-spacing: 1px;\n}\n\n.logo img {\n  width: 32px;\n  height: 32px;\n  margin-right: 5px;\n}\n\n</style>\n"]}]}